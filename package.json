{
  "name": "mcweb-export",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "纯前端 Minecraft 版本/整合包解析与下载器，导出为启动器可用的 .minecraft 压缩包",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "serve": "node tools/serve.mjs",
    "verify": "node tools/node-verify.mjs",
    "wasm": "node tools/build-wasm.mjs",
    "wasm:patch": "node tools/build-javapatch.mjs",
    "test:hash": "node tools/test-hash.mjs",
    "test:gdiff": "node tools/test-gdiff.mjs",
    "test:patch": "node tools/test-patch.mjs",
    "gateway": "node ../mc-gateway/server.js",
    "test:retry": "node tools/test-retry.mjs",
    "key": "node tools/extract-hmcl-key.mjs",
    "build": "node tools/build-dist.mjs",
    "deploy": "npm run build && npx wrangler deploy",
    "test:remap": "node tools/art-remap-test.mjs"
  },
  "devDependencies": {
    "wabt": "^1.0.39"
  }
}
